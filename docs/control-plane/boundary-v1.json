    {"pattern": "tests/test_jarvis.py", "class": "protected-oracle-source"},
    {"pattern": "AGENTS.md", "class": "agent-policy"},
    {"pattern": "README.md", "class": "authorization-contract"},
    {"pattern": "START.md", "class": "agent-and-promotion-policy"},
    {"pattern": "VERSION", "class": "deployment-identity"},
    {"pattern": "docs/DECISIONS.md", "class": "policy-record"},
    {"pattern": "docs/assignments/README.md", "class": "work-allocation-policy"},
    {"pattern": "docs/assignments/TEMPLATE.md", "class": "work-allocation-policy"},
    {"pattern": "docs/FEATURES.md", "class": "human-validation-index"},
